        { "id": "warranty", "label": "گارانتی معتبر",      "bonus": 0.08 },
        { "id": "manual",   "label": "دفترچه و متعلقات",   "bonus": 0.02 },
        { "id": "service",  "label": "سرویس دوره‌ای مستند", "bonus": 0.03 },
        { "id": "inverter", "label": "کمپرسور اینورتر",    "bonus": 0.04 },
