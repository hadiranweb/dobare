# آدرس دیتابیس PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# رمز ورود به پنل مدیریت (/admin)
ADMIN_PASSWORD=a-strong-secret

# بات تلگرام برای اعلان درخواست‌های جدید (اختیاری)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# شماره تماس و آیدی تلگرام شما — بعد از ثبت موفقِ درخواست به خریدار نمایش داده می‌شود (اختیاری)
SELLER_PHONE=09123456767
SELLER_TELEGRAM=my_username
