# ═══════════ تنظیمات دیتابیس ═══════════
# این سه مقدار برای ساخت کانتینر PostgreSQL استفاده می‌شوند
POSTGRES_USER=dobare
POSTGRES_PASSWORD=یک-رمز-قوی-برای-دیتابیس
POSTGRES_DB=dobare

# ⚠️ این آدرس باید دقیقاً با سه مقدار بالا هم‌خوان باشد
#    (نام کاربری و رمز و نام دیتابیس یکسان؛ هاست = postgres)
DATABASE_URL=postgresql://dobare:یک-رمز-قوی-برای-دیتابیس@postgres:5432/dobare

# آدرس عمومی سایت — بیلدتایم است؛ روی لیارا بعد از تغییر نیاز به دیپلوی جدید دارد
NEXT_PUBLIC_SITE_URL=https://dobare.liara.run

# ═══════════ دامنه و SSL (مسیر VPS) ═══════════
# دامنه‌ای که به IP سرور اشاره می‌کند (بدون https://)
DOMAIN=example.com
# ایمیل برای گواهی SSL رایگان Let's Encrypt
ACME_EMAIL=you@example.com

# ═══════════ پنل مدیریت (/admin) ═══════════
ADMIN_PASSWORD=رمز-قوی-مدیریت

# ═══════════ رزرو خودکار ═══════════
# مدت رزرو وسیله پس از ثبت درخواست، بر حسب ساعت
RESERVATION_HOURS=6

# ═══════════ بات تلگرام (اختیاری) ═══════════
# از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=
# شناسه چت خودتان — با نوشتن پیامی به بات و باز کردن
# https://api.telegram.org/bot<توکن>/getUpdates پیدا می‌شود
TELEGRAM_CHAT_ID=
# رشته‌ی تصادفی برای امنیت وب‌هوک بات (حداقل ۲۰ کاراکتر) — ساخت: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# شناسه‌های چت مجاز برای دستورهای مدیریتی بات، جدا با کاما (خالی = فقط TELEGRAM_CHAT_ID)
TELEGRAM_ADMIN_IDS=
# فقط اگر سرور به api.telegram.org دسترسی ندارد (دیتاسنتر ایران) — آدرس پروکسی Cloudflare Worker (راهنما: docs/telegram-proxy.md)
TELEGRAM_API_BASE=

# ═══════════ تماس شما با خریدار (اختیاری) ═══════════
# بعد از ثبت موفق درخواست به خریدار نمایش داده می‌شود
SELLER_PHONE=09123456767
SELLER_TELEGRAM=my_username

# ═══════════ یادآوری استقرار روی لیارا ═══════════
# مقادیر واقعی این فایل هرگز وارد گیت نمی‌شوند؛
# روی لیارا متغیرها را در کنسول (ENV Vars برنامه) تنظیم کنید و
# DATABASE_URL را از بخش «شبکه خصوصی» دیتابیس dobare-db بردارید:
#   postgresql://USER:PASSWORD@dobare-db:5432/postgres
# UPLOAD_DIR روی لیارا = /app/data/uploads (مسیر mount دیسک در liara.json)
# راهنمای کامل: docs/liara-console-setup.md
