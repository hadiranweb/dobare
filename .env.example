# ═══════════ تنظیمات دیتابیس ═══════════
# این سه مقدار برای ساخت کانتینر PostgreSQL استفاده می‌شوند
POSTGRES_USER=dobare
POSTGRES_PASSWORD=یک-رمز-قوی-برای-دیتابیس
POSTGRES_DB=dobare

# ⚠️ این آدرس باید دقیقاً با سه مقدار بالا هم‌خوان باشد
#    (نام کاربری و رمز و نام دیتابیس یکسان؛ هاست = postgres)
DATABASE_URL=postgresql://dobare:یک-رمز-قوی-برای-دیتابیس@postgres:5432/dobare

# ═══════════ دامنه و SSL ═══════════
# دامنه‌ای که به IP سرور اشاره می‌کند (بدون https://)
DOMAIN=example.com
# ایمیل برای گواهی SSL رایگان Let's Encrypt
ACME_EMAIL=you@example.com

# ═══════════ پنل مدیریت (/admin) ═══════════
ADMIN_PASSWORD=رمز-قوی-مدیریت

# ═══════════ رزرو خودکار ═══════════
# مدت رزرو وسیله پس از ثبت درخواست، بر حسب ساعت
RESERVATION_HOURS=6

# ═══════════ بات تلگرام (اختیاری) ═══════════
# از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=
# شناسه چت خودتان — با نوشتن پیامی به بات و باز کردن
# https://api.telegram.org/bot<توکن>/getUpdates پیدا می‌شود
TELEGRAM_CHAT_ID=

# ═══════════ تماس شما با خریدار (اختیاری) ═══════════
# بعد از ثبت موفق درخواست به خریدار نمایش داده می‌شود
SELLER_PHONE=09123456767
SELLER_TELEGRAM=my_username
